# Copiá este archivo a .env.local y completalo. Ninguna variable con secreto va al repo.

# --- Supabase (etapa 2 en adelante) -----------------------------------------
# Local: los imprime `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor. Saltea RLS: lo usan /api/rounds/:id/start y /api/attempts/:id/finish.
SUPABASE_SERVICE_ROLE_KEY=

# --- Desarrollo ---------------------------------------------------------------
# Fecha simulada (YYYY-MM-DD) para probar "el día siguiente". Solo en desarrollo.
# También se puede fijar sin reiniciar desde http://localhost:3000/dev/hoy
# DEV_FAKE_TODAY=
# Apaga la suscripción Realtime del ranking (queda el refresco periódico).
# Necesario con el emulador scripts/mini-supabase; con Supabase real, no.
# NEXT_PUBLIC_DISABLE_REALTIME=1

# --- Web Push -----------------------------------------------------------------
# Generar una sola vez con: npx web-push generate-vapid-keys
# (cambiarlas invalida todas las suscripciones existentes)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alguien@ejemplo.com
# Secreto que el scheduler (pg_cron + pg_net, o el cron de Vercel) manda como
# Authorization: Bearer al endpoint /api/push/reminders.
CRON_SECRET=
