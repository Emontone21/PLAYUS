# Copiá este archivo a .env.local y completalo. Ninguna variable con secreto va al repo.

# --- Supabase (etapa 2 en adelante) -----------------------------------------
# Local: los imprime `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor. Saltea RLS: lo usan /api/rounds/:id/start y /api/attempts/:id/finish.
SUPABASE_SERVICE_ROLE_KEY=

# --- Desarrollo ---------------------------------------------------------------
# Fecha simulada (YYYY-MM-DD) para probar "el día siguiente". Solo en desarrollo.
# DEV_FAKE_TODAY=

# --- Web Push (etapa 6, todavía no se usan) -----------------------------------
# Generar con: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:alguien@ejemplo.com
# Secreto que pg_cron manda al endpoint del recordatorio diario.
# CRON_SECRET=
